Output demo-try.gif
Set Shell zsh
Set FontSize 15
Set Width 960
Set Height 340
Set Padding 18
Set TypingSpeed 35ms
Set Theme { "background": "#0E1118", "foreground": "#e6edf3", "cursor": "#FF8C32", "black": "#0E1118", "blue": "#78BEF0", "cyan": "#78BEF0", "green": "#8fd18f", "yellow": "#FF8C32", "red": "#ff6b6b", "magenta": "#c792ea", "white": "#e6edf3", "brightBlack": "#6b7280", "brightBlue": "#78BEF0", "brightGreen": "#8fd18f", "brightYellow": "#FF8C32", "brightRed": "#ff6b6b", "brightWhite": "#ffffff", "brightCyan": "#78BEF0", "brightMagenta": "#c792ea" }
Type "kling try -- uname -a"
Enter
Sleep 4s
Type "kling try -- sh -c 'python3 --version; node --version'"
Enter
Sleep 4.5s
Type "kling try -egress internet -- sh -c 'wget -qO- https://api.github.com/zen; echo'"
Enter
Sleep 5s
Sleep 2s
