# Fragmento común del kernel de invitado de kindling (6.1 LTS).
#
# NO es un .config completo: build.sh lo aplica con
#   make allnoconfig KCONFIG_ALLCONFIG=<config-common + config-$arch>
# y después olddefconfig. Todo lo que no aparece aquí queda en "n" salvo que
# otra opción lo seleccione. Parte de la config de microVM del CI de Firecracker
# (resources/guest_configs/microvm-kernel-ci-*-6.1.config), recortada a lo que
# el invitado usa; scripts/check-kernel-config.sh verifica el resultado.
#
# OJO con allnoconfig: pone a "n" toda opción con pregunta, también las que por
# defecto valen "y" (FUTEX, EPOLL, BINFMT_SCRIPT, las mitigaciones...). Por eso
# muchas líneas de aquí parecen redundantes: no lo son. EXPERT=y hace visibles
# las preguntas de SERIO/VT/INPUT/IO_URING, que sin él se quedan en su "y" por
# defecto sin que allnoconfig pueda apagarlas.

# ── general ──────────────────────────────────────────────────────────────────
CONFIG_LOCALVERSION="-kindling"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="kindling"
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_BASE_FULL=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_KALLSYMS=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_VM_EVENT_COUNTERS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_IO_URING is not set
# CONFIG_SGETMASK_SYSCALL is not set
# CONFIG_SYSFS_SYSCALL is not set
# CONFIG_UID16 is not set
# CONFIG_PCSPKR_PLATFORM is not set
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_COMPAT_BRK is not set
# CONFIG_PROFILING is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_SMP=y
CONFIG_NR_CPUS=32

# BPF: bpf(2) se queda para systemd (cgroup/device), pero solo para root.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# ── cgroups y namespaces (systemd, runtimes dentro del invitado) ─────────────
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# ── fuera ────────────────────────────────────────────────────────────────────
# CONFIG_MODULES is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_CPU_FREQ is not set

# ── memoria ──────────────────────────────────────────────────────────────────
CONFIG_SLUB=y
CONFIG_SWAP=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_BALLOON_COMPACTION=y

# ── endurecimiento ───────────────────────────────────────────────────────────
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# ── ejecutables ──────────────────────────────────────────────────────────────
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=y

# ── bloque ───────────────────────────────────────────────────────────────────
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y

# dm-verity: las imágenes con "verity": true (constructores debian y android)
# montan la capa por /dev/mapper (internal/imagen, verityBlock) y, sin esto, el
# init se para en vez de montarla sin verificar. FEC opcional en la tabla; sin
# firma de la raíz (la tabla va en la base, que es del mismo constructor).
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
# CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG is not set
CONFIG_CRYPTO_SHA256=y

# ── red ──────────────────────────────────────────────────────────────────────
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
# CONFIG_IP_PNP_DHCP is not set
# CONFIG_IP_PNP_BOOTP is not set
# CONFIG_IP_PNP_RARP is not set
CONFIG_IPV6=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set

# ── virtio ───────────────────────────────────────────────────────────────────
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# ── dispositivos: solo consola ───────────────────────────────────────────────
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
# CONFIG_VT is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# CONFIG_SERIAL_8250_EXTENDED is not set
# CONFIG_SERIAL_8250_DMA is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_HID is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_WATCHDOG is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_POWER_SUPPLY is not set
# CONFIG_FW_LOADER is not set

# ── sistemas de ficheros ─────────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_FILE_LOCKING=y
CONFIG_FSNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_AUTOFS_FS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
# CONFIG_MISC_FILESYSTEMS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set

# ── depuración: nada que cueste en arranque ni en tamaño ─────────────────────
CONFIG_DEBUG_INFO_NONE=y
CONFIG_STRIP_ASM_SYMS=y
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_RUNTIME_TESTING_MENU is not set
