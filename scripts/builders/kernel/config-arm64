# Fragmento arm64 del kernel de invitado de kindling (6.1 LTS), sobre config-common.
# Lo que se repite aquí manda sobre config-common (va después).
#
# Sirve a dos VMMs con el mismo Image:
#   - Firecracker (Graviton): todo por device tree, GICv3, 8250 MMIO como
#     ttyS0, RTC PL031 y virtio-mmio;
#   - Virtualization.framework (backend vz, macOS): virtio por PCI (host ECAM
#     genérico) y consola virtio en hvc0. Por eso aquí PCI SÍ va; en amd64 no.
#     vz/internal/spec/spec.go (TranslateBootArgs) quita pci=off y cambia la
#     consola por eso mismo.

CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_PA_BITS_52 is not set
# CONFIG_COMPAT is not set
# CONFIG_NUMA is not set
# CONFIG_ACPI is not set
CONFIG_OF=y

# Extensiones de CPU. Tienen pregunta y "y" por defecto: allnoconfig las apagaría.
CONFIG_ARM64_USE_LSE_ATOMICS=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_SVE=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_BTI_KERNEL=y
CONFIG_ARM64_E0PD=y
CONFIG_ARM64_CNP=y
CONFIG_ARM64_TLB_RANGE=y
CONFIG_RODATA_FULL_DEFAULT_ENABLED=y

# Mitigaciones (nombres de 6.1).
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=y
CONFIG_ARM64_SW_TTBR0_PAN=y

# Erratas de los núcleos donde corre Firecracker: Graviton1 (a1.metal) =
# Cortex-A72, Graviton2 y Ampere Altra (OCI A1) = Neoverse N1, Graviton3 = V1,
# Graviton4 = V2, Cobalt 100 = N2, Raspberry Pi 5 = Cortex-A76. El invitado ve
# el MIDR del host, así que el parche se activa solo donde toca. También tienen
# pregunta con "y" por defecto. Todas existen en 6.1.140 (comprobado en
# arch/arm64/Kconfig); las que dependen de COMPAT (1418040) se caen solas y
# build.sh lo avisa.
# Fuera a propósito: las de TRBE/CoreSight (2119858, 2139208, 2253138...) porque
# el invitado no tiene CORESIGHT_TRBE, y 2457168 (A510) porque pide
# ARM64_AMU_EXTN. 2645198 no existe en 6.1 (llegó en 6.2).
CONFIG_ARM64_ERRATUM_1165522=y
CONFIG_ARM64_ERRATUM_1286807=y
CONFIG_ARM64_ERRATUM_1319367=y
CONFIG_ARM64_ERRATUM_1418040=y
CONFIG_ARM64_ERRATUM_1463225=y
CONFIG_ARM64_ERRATUM_1508412=y
CONFIG_ARM64_ERRATUM_1530923=y
CONFIG_ARM64_ERRATUM_1542419=y
CONFIG_ARM64_ERRATUM_2067961=y
CONFIG_ARM64_ERRATUM_2441007=y
CONFIG_ARM64_ERRATUM_2441009=y
CONFIG_ARM64_ERRATUM_2658417=y
CONFIG_ARM64_ERRATUM_2966298=y
CONFIG_ARM64_ERRATUM_3194386=y

# Consola: 8250 descrito en el device tree (Firecracker) y hvc0 (vz).
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_VIRTIO_CONSOLE=y

# Reloj de pared: Firecracker arm64 lo expone con un PL031.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y

# PCI mínimo para vz: host ECAM genérico y virtio-pci. Ningún driver PCI más.
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_PCI=y
# CONFIG_VIRTIO_PCI_LEGACY is not set
# CONFIG_PCIEPORTBUS is not set
CONFIG_PCI_MSI=y

# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_MOUSE_PS2 is not set

# SHA-256 de dm-verity con las instrucciones criptográficas de ARMv8 (M4,
# Graviton).
CONFIG_KERNEL_MODE_NEON=y
CONFIG_CRYPTO_SHA256_ARM64=y
CONFIG_CRYPTO_SHA2_ARM64_CE=y

# binfmt_misc: imágenes OCI solo-amd64 en un anfitrión arm64 (Mac, Graviton)
# con qemu-user dentro del invitado (docs/imagenes-amd64.md). El agente lo
# registra al arrancar solo si la imagen va emulada; sin eso no cuesta nada.
CONFIG_BINFMT_MISC=y

# Tics: se queda en HZ_250 (el de siempre). Probado HZ_100 en el Mac (vz y
# hv, n=10, docs/imagenes-amd64.md): en reposo da lo mismo (con NO_HZ_IDLE un
# vCPU dormido ya no recibe el tic; quedan temporizadores e IPIs, ~0,7/s por
# vCPU) y con él el e2e de Mac falla 2 de 2 en "freeze/thaw with a live share"
# (EIO de una escritura en vuelo al volver la sesión FUSE), que con 250 pasa.
# Ni detector de bloqueos (ni soft ni hard: el hard pide perf/NMI, que no
# hay) ni tareas colgadas: hilos que se despiertan solos para vigilar.
# allnoconfig ya los deja fuera; se dicen para que build.sh avise si vuelven.
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_WQ_WATCHDOG is not set
