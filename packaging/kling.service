[Unit]
Description=kling - daemon de microVMs Firecracker
Documentation=https://github.com/juan52878911/kindling
After=network.target
ConditionPathExists=/dev/kvm

[Service]
Type=simple
# Necesita root: abre /dev/kvm, monta rootfs y lanza procesos firecracker.
#
# KLING_SOCKET_USER (cede el socket al usuario que entra por SSH, para no
# ejecutar el CLI con sudo) y KLING_RUN_AS (usuario sin privilegios con el que
# corre Firecracker) cambian de máquina en máquina. Por eso NO van grabados
# aquí con Environment=: esta unidad la reinstala `make deploy` en cada
# despliegue, y un valor de aquí pisaría lo que cada host configuró. Van en
# /etc/default/kling, que `make deploy` solo crea la primera vez (nunca lo
# pisa) y el "-" de abajo hace opcional, para que la unidad funcione con los
# valores por defecto del binario aunque el fichero no exista todavía.
#
# Para crear el usuario sin privilegios de KLING_RUN_AS (por defecto "kindling"):
#   useradd --system --no-create-home --shell /usr/sbin/nologin kindling
#   usermod -aG kvm kindling
EnvironmentFile=-/etc/default/kling
ExecStart=/usr/local/bin/kling daemon
Restart=on-failure
RestartSec=2

# CRÍTICO: sin esto systemd mata TODO el cgroup al reiniciar el servicio, y se
# lleva por delante las microVMs en marcha. Con KillMode=process solo se detiene
# el daemon; al volver, reconcile() readopta las que sigan vivas.
KillMode=process

# Los cgroups de las microVMs viven en /sys/fs/cgroup/kindling, fuera del árbol
# de systemd: colgarlos del cgroup del servicio rompe el arranque con 219/CGROUP,
# porque cgroup v2 prohíbe tener procesos y controladores delegados a la vez.

[Install]
WantedBy=multi-user.target
