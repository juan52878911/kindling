{
  "familias": [
    {
      "nombre": "postgres",
      "detecta": ["usr/local/bin/postgres", "usr/lib/postgresql/*/bin/postgres"],
      "quita": [
        "usr/lib/libLLVM*", "usr/lib/llvm*", "usr/lib/*/libLLVM*", "usr/lib/llvm-*",
        "usr/lib/*/libz3*", "usr/lib/*/libclang*",
        "usr/local/lib/postgresql/llvmjit*", "usr/local/lib/postgresql/bitcode",
        "usr/lib/postgresql/*/lib/llvmjit*", "usr/lib/postgresql/*/lib/bitcode",
        "usr/local/include", "usr/include", "usr/include/postgresql", "usr/lib/postgresql/*/include",
        "usr/local/lib/postgresql/pgxs", "usr/lib/postgresql/*/lib/pgxs",
        "usr/local/lib/*.a",
        "usr/local/share/doc", "usr/local/share/man", "usr/share/man", "usr/share/doc", "usr/share/info",
        "usr/share/lintian", "var/cache/apk/*", "var/lib/apt/lists/*", "var/cache/apt",
        "usr/share/gnupg", "usr/share/doc-base",
        "usr/lib/*/perl*", "usr/lib/*/libperl*", "usr/share/perl*", "usr/bin/perl*", "usr/lib/x86_64-linux-gnu/perl-base",
        "usr/share/i18n", "usr/share/locale/*", "usr/local/share/locale/*",
        "usr/share/postgresql/*/man",
        "usr/local/bin/ecpg", "usr/local/bin/pg_test_fsync", "usr/local/bin/pg_test_timing", "usr/local/bin/pg_waldump", "usr/local/bin/pg_walsummary", "usr/local/bin/pg_archivecleanup", "usr/local/bin/pg_upgrade", "usr/local/bin/pg_combinebackup", "usr/local/bin/pg_createsubscriber", "usr/local/bin/pg_verifybackup", "usr/local/bin/pg_amcheck", "usr/local/bin/oid2name", "usr/local/bin/vacuumlo",
        "usr/lib/postgresql/*/bin/ecpg", "usr/lib/postgresql/*/bin/pg_test_fsync", "usr/lib/postgresql/*/bin/pg_test_timing", "usr/lib/postgresql/*/bin/pg_waldump", "usr/lib/postgresql/*/bin/pg_walsummary", "usr/lib/postgresql/*/bin/pg_archivecleanup", "usr/lib/postgresql/*/bin/pg_upgrade", "usr/lib/postgresql/*/bin/pg_combinebackup", "usr/lib/postgresql/*/bin/pg_createsubscriber", "usr/lib/postgresql/*/bin/pg_verifybackup", "usr/lib/postgresql/*/bin/pg_amcheck", "usr/lib/postgresql/*/bin/oid2name", "usr/lib/postgresql/*/bin/vacuumlo",
        "usr/local/lib/libecpg*", "usr/local/lib/libpgtypes*", "usr/lib/*/libecpg*", "usr/lib/*/libpgtypes*"
      ],
      "queda": [
        {"dir": "usr/lib/locale", "salvo": ["C", "C.utf8", "C.UTF-8", "POSIX"], "salvoEntorno": "LANG"}
      ],
      "añadeArgs": {"siEmpieza": "postgres", "args": ["-c", "jit=off"]}
    },
    {
      "nombre": "timescaledb",
      "detecta": ["usr/local/lib/postgresql/timescaledb.so"],
      "quita": [
        "usr/local/share/postgresql/extension/timescaledb--*--*.sql"
      ],
      "ultimaVersion": [
        {"dir": "usr/local/lib/postgresql", "patron": "^(timescaledb(?:-tsl)?)-([0-9]+(?:\\.[0-9]+)*)\\.so$"},
        {"dir": "usr/local/share/postgresql/extension", "patron": "^(timescaledb)--([0-9]+(?:\\.[0-9]+)*)\\.sql$"}
      ]
    }
  ]
}
