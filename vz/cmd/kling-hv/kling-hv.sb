;; Perfil de sandbox de kling-hv: el de kling-vz (vz/cmd/kling-vz/kling-vz.sb)
;; sin lo que pide Virtualization.framework (servicios XPC, IOKit, memoria
;; compartida, pantalla): Hypervisor.framework entra al kernel directamente.
;; Lo aplica el propio proceso (internal/sandbox) justo antes de crear o
;; restaurar la VM. kling-hv procesa dentro de sí el
;; tráfico del invitado (pila de red de usuario, DNS, MMDS): si un invitado hostil
;; encontrara un fallo ahí, esto es lo que puede tocar. Y lo que no: las demás
;; máquinas. Nada de la raíz entera: ni secrets/ (la clave de la que salen las
;; de todos los credentials.enc), ni los dorados de otros, ni sus directorios,
;; ni sus reenvíos. Parámetros (todos presentes salvo los L y E que no hay):
;;   ROOT    la raíz de datos de kindling
;;   MDIR    el directorio de esta máquina
;;   NET     "1" si la máquina tiene salida (egress distinto de none)
;;   BROKER  el socket del daemon por el que se piden las conexiones de las
;;           aristas de grafo, de kling db attach y del upstream en el
;;           loopback de una credencial (pkg/linkbroker)
;;   GFX     (sin uso: kling-hv no tiene pantalla)
;;   NL NE   cuántos ficheros L y E hay (hasta 16 de cada)
;;   L0..    ficheros que solo lee: kernel, discos de solo lectura, el fichero
;;           de memoria que restaura (su dorado o su congelación), que se mapea
;;           MAP_PRIVATE como RAM
;;   E0..    ficheros que lee y escribe: sus discos de lectura y escritura
;;           (su overlay, sus volúmenes)
(version 1)
(deny default)
(import "system.sb")

;; Lo que el proceso necesita: su propia información (phys_footprint, la CPU
;; de los hilos de vCPU), sysctl y, para el filtro por usuario del reenvío
;; (internal/peercred), ver los procesos y sockets de los demás. Ni
;; mach-lookup, ni IOKit, ni memoria compartida: hv_vm_create y compañía
;; funcionan sin ellos (medido en macOS 26.5, M4).
(allow process-info* (target self))
(allow process-info-listpids)
(allow process-info-pidinfo)
(allow process-info-pidfdinfo)
(allow sysctl-read)
(allow file-read-metadata)

(define (si-hay nombre regla)
  (if (not (string=? (param nombre) "")) (regla (param nombre))))
(define (cada-uno prefijo n regla)
  (if (> n 0)
    (begin (si-hay (string-append prefijo (number->string (- n 1))) regla)
           (cada-uno prefijo (- n 1) regla))))

;; Ficheros: su directorio entero (socket, log de auditoría, overlay y
;; congelación) y los ficheros exactos de su VM. Un snapshot dorado de
;; kling commit (snapshots/<nombre>/) no lo escribe este proceso: lo vuelca en
;; su directorio y lo publica el daemon (internal/machine/publicar_volcado.go).
(allow file-read* file-write* file-ioctl (subpath (param "MDIR")))
(cada-uno "L" (string->number (param "NL")) (lambda (f) (allow file-read* (literal f))))
(cada-uno "E" (string->number (param "NE")) (lambda (f) (allow file-read* file-write* file-ioctl (literal f))))

;; Red: su API (socket Unix en el directorio de la máquina) y sus reenvíos,
;; que escuchan en 127.0.0.1 (cualquier puerto: escuchar no da acceso a nada
;; de otra máquina, conectar sí, y eso sigue cerrado); el socket del broker del
;; daemon y ningún otro socket Unix de fuera; y salida al exterior solo si la
;; máquina la tiene. Nunca al loopback del Mac (0.0.0.0 incluido, que en macOS
;; llega a él), donde están los reenvíos de las demás máquinas y su agente
;; (exec): el upstream de una credencial en el loopback (-upstream
;; 127.0.0.1:5432) lo marca el daemon y se lo entrega por el broker
;; (pkg/linkbroker, KindLoopback). Así no hace falta una regla por puerto del
;; rango de los reenvíos: 1000 reglas eran ~20 ms de compilar el perfil en
;; cada arranque y cada restauración.
(allow network-bind network-inbound (local unix-socket (subpath (param "MDIR"))))
(allow network-bind network-inbound (local ip "localhost:*"))
(allow network-outbound (remote unix-socket (path-literal (param "BROKER"))))
(if (string=? (param "NET") "1")
  (allow network-outbound (remote ip "*:*")))
(deny network-outbound (remote ip "localhost:*"))

;; Por si un fichero de la VM apuntara ahí (un disco o un estado mal
;; reapuntado por el daemon): secrets/ nunca, y los dorados nunca para
;; escribir. Van al final para ganar a cualquier regla anterior.
(deny file-read* file-write* (subpath (string-append (param "ROOT") "/secrets")))
(deny file-write* (subpath (string-append (param "ROOT") "/snapshots")))
