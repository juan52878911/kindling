CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_LIBNVDIMM=y
CONFIG_BLK_DEV_PMEM=y
CONFIG_ND_BLK=y
CONFIG_BTT=y
CONFIG_NVDIMM_PFN=y
CONFIG_NVDIMM_DAX=y
CONFIG_DAX=y
CONFIG_FS_DAX=y
CONFIG_FS_DAX_PMD=y
CONFIG_VIRTIO_PMEM=y
