# El gateway de IA de la demo: capas 1-3 (/v1/decide) y 4 (/v1/generate) sobre
# el daemon de kindling del host. Es el gateway de kindling (pkg/aigw) con el
# dominio "smart-room" dentro: `kindling-domotica gateway`, no `kling ai
# serve`, que no lo trae. Socket 0600 del usuario; nada en la red.
[Unit]
Description=kindling AI gateway for the smart-home demo (kindling-domotica gateway)
After=kling.service
Requires=kling.service

[Service]
User=juan
WorkingDirectory=/home/juan/domotica
ExecStart=/home/juan/domotica/kindling-domotica gateway -config /home/juan/domotica/ai.json -socket /home/juan/domotica/ai.sock -id domotica -idle 2m -max-replicas 1
# SIGHUP relee ai.json (lo mismo que `kling ai reload -socket …`).
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# Al parar congela sus réplicas: dale tiempo.
TimeoutStopSec=90
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# ~/.config/kling guarda la popularidad de los modelos; «-»: si no existe, no
# impide arrancar (créala con mkdir -p para que se guarde).
ReadWritePaths=/home/juan/domotica -/home/juan/.config/kling

[Install]
WantedBy=multi-user.target
